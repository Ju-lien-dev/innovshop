{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

    {# Favicons #}
    <link rel="icon" href="{{ asset('favicon.ico') }}">
    <link rel="icon" type="image/png" href="{{ asset('logo/favicon.png') }}">
    <link rel="shortcut icon" href="{{ asset('logo/favicon.png') }}">

    {# Encore (tes assets compilés) #}
    {% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {% endblock %}

    {# Bootstrap CDN #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* === Sticky footer layout === */
        html,
        body {
            height: 100%;
            margin: 0;
        }

        body.layout {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .site-main {
            flex: 1 0 auto;
            padding-bottom: 16px;
        }

        .site-footer {
            margin-top: auto;
            width: 100%;
        }

        /* === Flash messages === */
        .flash-message {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            background: #0f172a;
            color: #fff;
            padding: 12px 18px;
            border-radius: 12px;
            font-weight: 600;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2);
            opacity: 0;
            transform: translateY(-10px);
            animation: slideIn 0.3s forwards, fadeOut 0.5s ease 3.5s forwards;
        }

        .flash-success {
            background: #16a34a;
        }

        .flash-warning {
            background: #eab308;
            color: #111;
        }

        .flash-danger {
            background: #dc2626;
        }

        @keyframes slideIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeOut {
            to {
                opacity: 0;
                transform: translateY(-10px);
            }
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.flash-message').forEach(flash => {
                flash.addEventListener('animationend', (e) => {
                    if (e.animationName === 'fadeOut') flash.remove();
                });
            });
        });
    </script>
</head>

<body class="layout" data-turbo="false">
    {# ===== Flash messages ===== #}
    {% for type, messages in app.flashes %}
    {% for message in messages %}
    <div class="flash-message flash-{{ type }}">{{ message }}</div>
    {% endfor %}
    {% endfor %}

    {% include 'partials/header.html.twig' %}

    <main id="content" class="site-main">
        {% block body %}{% endblock %}
    </main>

    {% include 'partials/footer.html.twig' with {'class': 'site-footer'} %}
</body>

</html>