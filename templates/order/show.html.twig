{% extends 'base.html.twig' %}

{% block title %}Commande #{{ order.reference }}{% endblock %}

{% block body %}
<style>
    .background {
        background-color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
    }

    .order-wrapper {
        max-width: 960px;
        margin: 40px auto;
        padding: 0 16px;
    }

    .order-card {
        background: #fff;
        border: 1px solid rgba(17, 24, 39, .08);
        border-radius: 18px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, .08);
        padding: 28px;
        margin-bottom: 20px;
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .order-header h1 {
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0;
    }

    .order-status {
        padding: 6px 14px;
        border-radius: 25px;
        font-size: .9rem;
        font-weight: 600;
    }

    .status-paid {
        background: #d1fae5;
        color: #065f46;
    }

    .status-processing {
        background: #fef3c7;
        color: #92400e;
    }

    .status-shipped {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-delivered {
        background: #e0e7ff;
        color: #312e81;
    }

    .order-info {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .order-info div {
        background: #f9fafb;
        border: 1px solid rgba(17, 24, 39, .06);
        border-radius: 12px;
        padding: 14px;
        font-size: .95rem;
    }

    .order-items {
        border-top: 1px solid rgba(17, 24, 39, .08);
        margin-top: 20px;
        padding-top: 20px;
    }

    .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px dashed rgba(17, 24, 39, .08);
    }

    .item:last-child {
        border-bottom: none;
    }

    .item-name {
        font-weight: 500;
    }

    .item-qty {
        color: #6b7280;
        font-size: .9rem;
    }

    .item-total {
        font-weight: 600;
    }
</style>
<div class="background"></div>
<div class="order-wrapper">
    <div class="order-card">
        <div class="order-header">
            <h1>Commande #{{ order.reference }}</h1>
            <span class="order-status 
                {% if order.status == 'paid' %}status-paid
                {% elseif order.status == 'processing' %}status-processing
                {% elseif order.status == 'shipped' %}status-shipped
                {% elseif order.status == 'delivered' %}status-delivered
                {% endif %}">
                {% if order.status == 'paid' %}
                Confirmée
                {% elseif order.status == 'processing' %}
                En préparation
                {% elseif order.status == 'shipped' %}
                Expédiée
                {% elseif order.status == 'delivered' %}
                Livrée
                {% else %}
                {{ order.status }}
                {% endif %}
            </span>
        </div>

        <div class="order-info">
            <div>
                <strong>Date :</strong><br>
                {{ order.createdAt|date('d/m/Y H:i') }}
            </div>
            <div>
                <strong>Total :</strong><br>
                {{ order.total }} €
            </div>
        </div>

        <div class="order-items">
            <h2>Articles</h2>
            {% for item in order.articles %}
            <div class="item">
                <div>
                    <div class="item-name">{{ item.nomProduit }}</div>
                    <div class="item-qty">x {{ item.quantite }}</div>
                </div>
                <div class="item-total">{{ item.sousTotal }} €</div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}