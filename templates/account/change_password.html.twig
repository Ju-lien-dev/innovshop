{# templates/account/change_password.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Changer mon mot de passe{% endblock %}

{% block body %}
<link href="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet">
<script src="//cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>

<style>
    .account-future {
        --af-bg: #fff;
        --af-text: #1f2937;
        --af-muted: #6b7280;
        --af-card: rgb(243, 241, 238);
        --af-border: rgba(17, 24, 39, .08);
        --af-buttons: #333;
        color: var(--af-text)
    }

    body {
        background: var(--af-bg)
    }

    .af-shell {
        max-width: 1100px;
        margin: 48px auto;
        padding: 24px
    }

    .af-card {
        background: var(--af-card);
        border: 1px solid var(--af-border);
        border-radius: 18px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, .15)
    }

    .af-header {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 28px
    }

    .af-avatar {
        width: 92px;
        height: 92px;
        border-radius: 50%;
        padding: 3px;
        background: linear-gradient(135deg, rgba(255, 255, 255, .505), #333);
        box-shadow: 0 8px 20px rgba(0, 0, 0, .15)
    }

    .af-avatar img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        background: #f3f4f6;
        border: 2px solid rgba(17, 24, 39, .06)
    }

    .af-identity h5 {
        margin: 0 0 4px;
        font-weight: 700;
        letter-spacing: .3px
    }

    .af-body {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 22px;
        padding: 22px
    }

    @media(max-width:992px) {
        .af-body {
            grid-template-columns: 1fr
        }
    }

    .af-side {
        background: #fff;
        border: 1px solid var(--af-border);
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 8px 24px rgba(2, 6, 23, .05)
    }

    .af-side h6 {
        font-size: .9rem;
        letter-spacing: .5px;
        color: var(--af-muted);
        margin-bottom: 12px
    }

    .af-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        margin-bottom: 8px;
        border-radius: 10px;
        color: var(--af-text);
        text-decoration: none;
        border: 1px solid transparent;
        transition: .2s
    }

    .af-link:hover {
        background: #f9fafb;
        border-color: var(--af-border);
        transform: translateY(-1px);
        text-decoration: none
    }

    .af-icon {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
        margin-right: 8px;
        color: var(--af-accent)
    }

    .af-icon path,
    .af-icon circle,
    .af-icon rect {
        stroke: currentColor;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round
    }

    .af-panel {
        background: #fff;
        border: 1px solid var(--af-border);
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 8px 24px rgba(2, 6, 23, .05)
    }

    .af-btn {
        border: 1px solid var(--af-border);
        color: #fff;
        background: var(--af-buttons);
        padding: 10px 16px;
        border-radius: 25px;
        cursor: pointer;
        transition: .18s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px
    }

    .af-btn:hover {
        border: 1px solid #333;
        background: #fff;
        color: var(--af-text);
        transform: translateY(-1px);
        box-shadow: 0 8px 24px rgba(2, 6, 23, .05);
        text-decoration: none
    }

    .af-btn.outline {
        background: #fff;
        color: var(--af-text)
    }

    .af-flash {
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 14px;
        border: 1px solid transparent;
        background: linear-gradient(90deg, rgba(6, 182, 212, .1), rgba(139, 92, 246, .08))
    }

    .account-future .form-control {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        color: var(--af-text);
        border-radius: 12px;
        padding: 10px 14px
    }

    .account-future .form-control:focus {
        background: #fff;
        border-color: rgba(6, 182, 212, .5);
        box-shadow: 0 8px 24px rgba(2, 6, 23, .05)
    }
</style>

<div class="account-future">
    <div class="af-shell">

        {# flashes #}
        {% for type, messages in app.flashes %}
        {% for message in messages %}
        <div class="af-flash {{ type == 'success' ? '' : (type == 'error' ? 'danger' : 'info') }}">{{ message }}</div>
        {% endfor %}
        {% endfor %}

        <div class="af-card">
            <!-- Header -->
            <div class="af-header">
                <div class="af-avatar">
                    <img src="https://placehold.co/400x400/f3f4f6/111?text=IS" alt="Avatar">
                </div>
                <div class="af-identity">
                    {% set fullNameHeader = (app.user.prenom ?? '') ~ ' ' ~ (app.user.nom ?? '') %}
                    <h5>{{ fullNameHeader|trim ?: (app.user.userIdentifier ?? 'Client') }}</h5>
                    <div class="meta">Client InnovShop</div>
                </div>
                <div class="ml-auto">
                    <a class="af-btn outline" href="{{ path('app_account') }}">← Retour</a>
                </div>
            </div>

            <!-- Body -->
            <div class="af-body">
                <!-- Sidebar -->
                <aside class="af-side">
                    <h6>Raccourcis</h6>
                    <a class="af-link" href="{{ path('app_account') }}">
                        <svg class="af-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="7" r="4"></circle>
                            <path d="M20 21a8 8 0 1 0-16 0"></path>
                        </svg>
                        Mon compte
                    </a>
                    <a class="af-link" href="{{ path('app_account_password') }}">
                        <svg class="af-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="10" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        Changer mon mot de passe
                    </a>
                    <a class="af-link" href="{{ path('app_account') }}#addresses">
                        <svg class="af-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3l7 6v10a2 2 0 0 1-2 2h-3v-6H10v6H7a2 2 0 0 1-2-2V9l7-6z"></path>
                        </svg>
                        Mes adresses
                    </a>
                    <a class="af-link" href="{{ path('app_catalogue') }}">
                        <svg class="af-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 6h18M3 12h18M3 18h18"></path>
                        </svg>
                        Catalogue
                    </a>
                </aside>

                <!-- Panel: Change password -->
                <section class="af-panel">
                    <h4 class="mb-2">Changer mon mot de passe</h4>
                    <p class="text-muted mb-3">Choisissez un mot de passe robuste (au moins 8 caractères, mélangez
                        lettres, chiffres, symboles).</p>

                    {{ form_start(form, {'attr': {'novalidate':'novalidate'}}) }}

                    {# Si ton formulaire comporte "currentPassword", décommente ce bloc :
                    <div class="form-group mt-2">
                        {{ form_label(form.currentPassword, 'Mot de passe actuel') }}
                        {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.currentPassword) }}
                    </div>
                    #}

                    <div class="form-group mt-2">
                        {{ form_label(form.plainPassword.first, 'Nouveau mot de passe') }}
                        {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.plainPassword.first) }}
                    </div>

                    <div class="form-group mt-2">
                        {{ form_label(form.plainPassword.second, 'Confirmer le mot de passe') }}
                        {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.plainPassword.second) }}
                    </div>

                    <div class="af-actions mt-4">
                        <a href="{{ path('app_account') }}" class="af-btn outline">Annuler</a>
                        <button type="submit" class="af-btn">Enregistrer</button>
                    </div>

                    {{ form_end(form) }}
                </section>
            </div>
        </div>

    </div>
</div>
{% endblock %}