{% extends 'base.html.twig' %}

{% block title %}Accès refusé{% endblock %}

{% block body %}
<style>
    .background {
        background-color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
    }
</style>
<div class="background"></div>
<div style="text-align: center; padding: 60px;">
    <h1 style="font-size: 3rem; color: #b91c1c;">🚫 Accès non autorisé</h1>
    <p style="font-size: 1.2rem; margin-top: 20px;">
        Vous n’avez pas les permissions nécessaires pour accéder à cette page.
    </p>

    {% if app.user %}
    <a href="{{ path('app_account') }}" class="btn btn-dark mt-4">Retour à mon compte</a>
    {% else %}
    <a href="{{ path('app_login') }}" class="btn btn-dark mt-4">Se connecter</a>
    {% endif %}
</div>
{% endblock %}