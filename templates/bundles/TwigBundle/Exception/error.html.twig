{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code|default(500) }}{% endblock %}

{% block body %}
<style>
    .background {
        background-color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
    }
</style>
<div class="background"></div>
<div style="text-align:center; padding:60px 20px;">
    <h1>Une erreur est survenue ({{ status_code|default(500) }})</h1>
    <p>Nous travaillons à la résoudre.</p>
</div>
{% endblock %}