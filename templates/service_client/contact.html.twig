{% extends 'base.html.twig' %}

{% block title %}Contact & SAV{% endblock %}

{% block body %}
<style>
    :root {
        --card-bg: #fff;
        --card-bd: #e5e7eb;
        --text-muted: #6b7280;
        --radius: 12px;
        --shadow: 0 1px 2px rgba(0, 0, 0, .05);
        --brand: #0ea5e9;
    }

    .background {
        background-color: #fff;
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
    }

    .page-hero h1 {
        margin: 0;
        font-weight: 800;
        letter-spacing: .2px;
    }

    .breadcrumb-sm a {
        color: var(--text-muted);
        text-decoration: none;
    }

    .breadcrumb-sm a:hover {
        text-decoration: underline;
    }

    .grid {
        display: grid;
        gap: 16px;
    }

    @media(min-width:992px) {
        .grid-2 {
            grid-template-columns: 2fr 1fr;
        }
    }

    .card {
        background: var(--card-bg);
        border: 1px solid var(--card-bd);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    .card .card-hd {
        padding: 14px 16px 0;
    }

    .card .card-bd {
        padding: 16px;
    }

    .card h2 {
        font-size: 1.25rem;
        margin: 0 0 8px;
    }

    .muted {
        color: var(--text-muted);
    }

    .kv {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .kv li {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 12px;
        padding: 6px 0;
    }

    a.link {
        color: var(--brand);
        text-decoration: none;
    }

    a.link:hover {
        text-decoration: underline;
    }

    .hr {
        height: 1px;
        background: var(--card-bd);
        margin: 16px 0;
    }
</style>

<div class="background"></div>

<section class="page-hero">
    <div class="container">
        <nav class="breadcrumb-sm mb-2">
            <a href="{{ path('app_front') }}">Accueil</a> · <span class="muted">Contact & SAV</span>
        </nav>
        <h1>Contact & Service Après-Vente</h1>
        <p class="muted mb-0">Besoin d’aide ? Notre équipe est à votre écoute.</p>
    </div>
</section>

<div class="container">
    <div class="grid grid-2">
        <!-- Colonne principale -->
        <div class="grid">
            <article class="card">
                <div class="card-hd">
                    <h2>Contactez-nous</h2>
                </div>
                <div class="card-bd">
                    <ul class="kv">
                        <li><span class="muted">Email</span>
                            <div><a class="link" href="mailto:support@innovshop.fr">support@innovshop.fr</a></div>
                        </li>
                        <li><span class="muted">Téléphone</span>
                            <div>+33 1 23 45 67 89</div>
                        </li>
                        <li><span class="muted">Adresse</span>
                            <div>12 rue de l’Exemple, 75000 Paris</div>
                        </li>
                        <li><span class="muted">Horaires</span>
                            <div>Lun–Ven, 9h à 18h</div>
                        </li>
                    </ul>
                </div>
            </article>

            <article class="card">
                <div class="card-hd">
                    <h2>Délai de réponse</h2>
                </div>
                <div class="card-bd">
                    <p>Nous répondons à toutes les demandes sous <strong>24 à 48h ouvrées</strong>. Pour un suivi
                        rapide, pensez à indiquer votre numéro de commande.</p>
                </div>
            </article>
        </div>

        <!-- Colonne latérale -->
        <aside class="grid">
            <div class="card">
                <div class="card-hd">
                    <h2>Récapitulatif</h2>
                </div>
                <div class="card-bd">
                    <ul class="kv">
                        <li><span class="muted">Site</span>
                            <div>{{ app.request.schemeAndHttpHost }}</div>
                        </li>
                        <li><span class="muted">Entreprise</span>
                            <div>InnovShop SAS</div>
                        </li>
                        <li><span class="muted">Email</span>
                            <div><a class="link" href="mailto:support@innovshop.fr">support@innovshop.fr</a></div>
                        </li>
                    </ul>
                    <div class="hr"></div>
                    <p class="muted mb-0">Voir aussi :
                        <a class="link" href="{{ path('service_livraison_paiements') }}">Livraison & paiements</a> ·
                        <a class="link" href="{{ path('service_retours_retractation') }}">Retours & rétractation</a>
                    </p>
                </div>
            </div>
        </aside>
    </div>
</div>
{% endblock %}