<style>
    :root {
        --card-bg: #fff;
        --card-bd: #e5e7eb;
        --text-muted: #6b7280;
        --radius: 12px;
        --shadow: 0 1px 2px rgba(0, 0, 0, .05);
        --brand: #0ea5e9;
    }

    .background {
        background-color: #fff;
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
    }

    .page-hero h1 {
        margin: 0;
        font-weight: 800;
        letter-spacing: .2px;
    }

    .breadcrumb-sm a {
        color: var(--text-muted);
        text-decoration: none;
    }

    .breadcrumb-sm a:hover {
        text-decoration: underline;
    }

    .grid {
        display: grid;
        gap: 16px;
    }

    @media(min-width:992px) {
        .grid-2 {
            grid-template-columns: 2fr 1fr;
        }
    }

    .card {
        background: var(--card-bg);
        border: 1px solid var(--card-bd);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    .card .card-hd {
        padding: 14px 16px 0;
    }

    .card .card-bd {
        padding: 16px;
    }

    .card h2 {
        font-size: 1.25rem;
        margin: 0 0 8px;
    }

    .muted {
        color: var(--text-muted);
    }

    .kv {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .kv li {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 12px;
        padding: 6px 0;
    }

    a.link {
        color: var(--brand);
        text-decoration: none;
    }

    a.link:hover {
        text-decoration: underline;
    }

    .hr {
        height: 1px;
        background: var(--card-bd);
        margin: 16px 0;
    }
</style>