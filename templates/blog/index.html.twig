{% extends 'base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet">
<link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">
<link href="https://fonts.googleapis.com/css?family=Libre+Baskerville:400,700" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/blog.css') }}">


{% endblock %}

{% block body %}
<style>
    .background {
        background-color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
    }
</style>
<div class="background"></div>
<section class="container">
    <div class="row">
        {% for article in articles %}
        <div class="col-md-4 mb-4">
            <div class="card profile-card-5">
                <div class="card-img-block">
                    {% if article.image %}
                    <img class="card-img-top" src="{{ asset('images/' ~ article.image) }}" alt="{{ article.titre }}">
                    {% endif %}
                </div>
                <div class="card-body pt-0">
                    <h5 class="card-title">{{ article.titre }}</h5>
                    <p class="card-text">{{ article.texte|raw }}</p>
                    <a href="{{path('blog_detail', {'id': article.id})}}" class="btn btn-primary">En savoir plus</a>
                </div>
            </div>
        </div>
        {% else %}
        <p class="col-12 text-center">Aucun article trouvé.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}