{% extends 'base.html.twig' %}

{% block title %}Détail Blog{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/blog.css') }}">
{% endblock %}



{% block body %}
<style>
    .background {
        background-color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
    }
</style>
<div class="background"></div>
<section class="container">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card profile-card-5">
                <div class="card-img-block">
                    {% if article.image %}
                    <img class="card-img-top" src="{{ asset('images/' ~ article.image) }}" alt="{{ article.titre }}">
                    {% endif %}
                </div>
                <div class="card-body pt-0">
                    <h5 class="card-title">{{ article.titre }}</h5>
                    <p class="card-text">{{ article.texte|raw }}</p>
                    <a href="{{path('app_blog')}}" class="btn btn-primary">Revenir à la page
                        précédente</a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}