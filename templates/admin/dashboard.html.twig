{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Dashboard{% endblock %}

{% block main %}
{% set STATUS_FR = {
'paid': 'Payée',
'processing': 'En préparation',
'shipped': 'Expédiée',
'delivered': 'Livrée',
'cancelled': 'Annulée'
} %}

<style>
    .kpi-value {
        font-weight: 700;
        font-size: clamp(1.15rem, 3.5vw, 2rem);
        line-height: 1.1;
        white-space: nowrap !important;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .no-wrap {
        white-space: nowrap !important;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #revenueChart {
        width: 100% !important;
        height: 100% !important;
        display: block;
    }
</style>

{# ===== KPIs (100% Bootstrap, responsive) ===== #}
<div class="container-fluid px-0">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Commandes (total)</div>
                    <div class="kpi-value">{{ metrics.orders_total }}</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">CA (total)</div>
                    <div class="kpi-value">
                        {{ metrics.revenue_total|number_format(2, '.', ' ')|replace({' ': '&nbsp;'})|raw }}&nbsp;€
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">CA (7 jours)</div>
                    <div class="kpi-value">
                        {{ metrics.revenue_7d|number_format(2, '.', ' ')|replace({' ': '&nbsp;'})|raw }}&nbsp;€
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">CA (30 jours)</div>
                    <div class="kpi-value">
                        {{ metrics.revenue_30d|number_format(2, '.', ' ')|replace({' ': '&nbsp;'})|raw }}&nbsp;€
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# ===== Deux colonnes responsives ===== #}
<div class="container-fluid px-0 mt-4">
    <div class="row g-3 row-cols-1 row-cols-lg-2">

        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">Répartition par statut</h2>
                    {% if metrics.by_status is not empty %}
                    <ul class="mb-0 ps-3">
                        {% for row in metrics.by_status %}
                        <li class="d-flex align-items-center justify-content-between gap-2 py-1">
                            <span class="text-muted">{{ STATUS_FR[row.status]|default(row.status|capitalize) }}</span>
                            <strong class="no-wrap">{{ row.nb }}</strong>
                        </li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <em>Aucune commande pour l’instant.</em>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5 mb-3">Dernières commandes</h2>
                    {% if latest is not empty %}
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Réf</th>
                                    <th>Date</th>
                                    <th>Client</th>
                                    <th class="text-end">Total</th>
                                    <th>Statut</th>
                                    <th style="width:1%"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for order in latest %}
                                <tr>
                                    <td class="text-nowrap">{{ order.reference }}</td>
                                    <td class="text-nowrap">{{ order.createdAt|date('d/m/Y H:i') }}</td>
                                    <td class="text-truncate" style="max-width:220px">
                                        {% if order.user %}
                                        {{ (order.user.prenom ~ ' ' ~ order.user.nom)|trim ?: order.user.email }}
                                        {% else %}
                                        <em>—</em>
                                        {% endif %}
                                    </td>
                                    <td class="text-end no-wrap">
                                        {{ order.total|number_format(2, '.', ' ')|replace({' ': '&nbsp;'})|raw }}&nbsp;€
                                    </td>
                                    <td>
                                        {% set status = order.status %}
                                        <span class="badge
                          {% if status == 'paid' %} bg-success
                          {% elseif status == 'processing' %} bg-warning text-dark
                          {% elseif status == 'shipped' %} bg-info text-dark
                          {% elseif status == 'delivered' %} bg-primary
                          {% elseif status == 'cancelled' %} bg-danger
                          {% else %} bg-secondary
                          {% endif %}">
                                            {{ STATUS_FR[status]|default(status|capitalize) }}
                                        </span>
                                    </td>
                                    <td class="text-nowrap">
                                        <a class="btn btn-sm btn-primary" href="{{ ea_url()
                             .setController('App\\Controller\\Admin\\CommandeCrudController')
                             .setAction('detail')
                             .setEntityId(order.id) }}">
                                            Détails
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <em>Aucune commande récente.</em>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
</div>

{# ===== Graph ===== #}
<div class="container-fluid px-0 mt-4">
    <div class="card">
        <div class="card-body" style="height:340px;">
            <h2 class="h5 mb-3">Chiffre d’affaires – 30 derniers jours</h2>
            <div class="position-relative h-100">
                <canvas id="revenueChart" class="position-absolute top-0 start-0 w-100 h-100"
                    data-labels='{{ chart_labels|json_encode|e("html_attr") }}'
                    data-values='{{ chart_values|json_encode|e("html_attr") }}'>
                </canvas>
            </div>
        </div>
    </div>
</div>

{# Chart.js #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    (function () {
        const el = document.getElementById('revenueChart');
        if (!el || typeof Chart === 'undefined') return;

        const labels = JSON.parse(el.dataset.labels || '[]');
        const values = JSON.parse(el.dataset.values || '[]');

        new Chart(el.getContext('2d'), {
            type: 'line',
            data: {
                labels,
                datasets: [{
                    label: 'CA (€) / jour',
                    data: values,
                    fill: true,
                    tension: 0.25,
                    borderWidth: 2,
                    pointRadius: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: true },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => ' ' + Number(ctx.parsed.y).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) + ' €'
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: v => Number(v).toLocaleString('fr-FR') + ' €' }
                    },
                    x: { ticks: { maxRotation: 0, autoSkip: true } }
                }
            }
        });
    })();
</script>
{% endblock %}