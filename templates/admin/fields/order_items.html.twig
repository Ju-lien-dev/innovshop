{# templates/admin/fields/order_items.html.twig #}
{% set o = entity.instance %}
{% set items = o.articles is iterable ? o.articles : [] %}

{% if items is not empty %}
<table class="table table-sm" style="margin:0">
    <thead>
        <tr>
            <th>Article</th>
            <th class="text-center" style="width:110px">Qté</th>
            <th class="text-end" style="width:140px">Prix unitaire</th>
            <th class="text-end" style="width:140px">Sous-total</th>
        </tr>
    </thead>
    <tbody>
        {% set total = 0 %}
        {% for line in items %}
        {% set q = (line.quantite ?? 1) * 1 %}
        {% set pu = (line.prix ?? 0) * 1 %}
        {% set st = (line.sousTotal ?? (pu * q)) * 1 %}
        {% set total = total + st %}

        <tr>
            <td>{{ line.nomProduit ?? 'Article' }}</td>
            <td class="text-center">{{ q }}</td>
            <td class="text-end">{{ pu|number_format(2, ',', ' ') }} €</td>
            <td class="text-end">{{ st|number_format(2, ',', ' ') }} €</td>
        </tr>
        {% else %}
        <tr>
            <td colspan="4"><em>Aucune ligne d’article valide.</em></td>
        </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total lignes</th>
            <th class="text-end">{{ total|number_format(2, ',', ' ') }} €</th>
        </tr>
        <tr>
            <th colspan="3" class="text-end">Total commande (enregistré)</th>
            <th class="text-end">{{ (o.total ?? 0)|number_format(2, ',', ' ') }} €</th>
        </tr>
    </tfoot>
</table>
{% else %}
<em>Aucune ligne d’article.</em>
{% endif %}