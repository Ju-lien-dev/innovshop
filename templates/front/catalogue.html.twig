{# templates/front/catalogue.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}
<!-- CDNs (comme ta version) -->
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.2/css/all.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js"></script>

<style>
  .background {
    background-color: #fff;
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  /* === Styles d’origine conservés === */
  .btn-main {
    display: inline-block;
    background: #333;
    color: #fff;
    padding: 10px 20px;
    border-radius: 30px;
    border: 1px solid #333;
    text-decoration: none;
    font-weight: bold;
    transition: background 0.4s;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .btn-main:hover {
    background: rgb(243, 241, 238);
    text-decoration: none;
    border: 1px solid #333;
    color: #333;
  }

  .badge23 {
    display: inline-block;
    padding: .30em .4em;
    font-size: 75%;
    font-weight: 300;
    line-height: 1;
    text-align: center;
    border-radius: .25rem;
    color: #fff;
    background-color: #28a745
  }

  .rating-review {
    color: #5b5b5b;
    font-size: 12px
  }

  .product_price {
    display: inline-block;
    font-size: 30px;
    font-weight: 400;
    margin-top: -11px;
    margin-bottom: 0;
    color: #080808;
    clear: left
  }

  .list-group-item {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, .125);
  }

  .seperator {
    background: #a2a2efb8
  }

  #ReinitButton {
    color: #333;
  }

  #ReinitButton:hover {
    background: #333;
    color: #fff;
  }

  .wrapper {
    width: 100%;
    margin-top: 48px;
    margin-left: 16px;
  }

  .panel {
    margin-bottom: 5px;
  }

  .panel-title {
    margin-bottom: 0;
  }

  .panel-collapse {
    background: #fff;
    border-bottom: 1px solid #d5d5d5;
  }

  .panel-heading {
    padding: 9px 3px !important;
    border: 0;
  }

  .panel-body {
    padding: 13px;
  }

  .panel-title>a {
    border: 1px solid #d5d5d5;
    display: block;
    padding: 10px;
    color: #555;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    word-spacing: 3px;
    text-decoration: none;
    transition: background .2s, color .2s, border-color .2s, box-shadow .2s;
  }

  .panel-heading a:before {
    font-family: 'Font Awesome 5 Free';
    content: "\f111";
    float: right;
    transition: all .5s
  }

  .panel-heading.active a:before {
    transform: rotate(180deg)
  }

  .panel-default>.panel-heading {
    color: #282b2f;
    background: #fff !important;
  }

  .ml-10 {
    margin-left: 10px;
    font-size: 12px;
    color: #080808
  }

  .btn.btn-out {
    outline: 1px solid #fff;
    outline-offset: -5px
  }

  .btn {
    border-radius: 2px;
    font-size: 11px;
    padding: 10px 19px;
    cursor: pointer;
    color: #fff
  }

  .refine {
    padding: 0 !important
  }

  .filters-text-top {
    margin-top: 20px;
    background: #fff;
    margin-bottom: 15px;
    padding: 12px
  }

  .filters-text {
    background: #fff;
    margin-bottom: 15px;
    padding: 12px
  }

  .filter-span {
    font-size: 17px;
    color: black;
  }

  /* État actif sur une catégorie (cohérent avec ton style) */
  .panel-title a.active,
  .panel-title a.active:focus,
  .panel-title a.active:hover {
    background: #333 !important;
    color: #fff !important;
    border-color: #333 !important;
    box-shadow: 0 6px 16px rgba(0, 0, 0, .15);
  }

  .panel-title a.active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: #28a745;
    border-radius: 4px 0 0 4px;
  }

  .panel-title a:not(.active):hover {
    background: #f2f2f2;
    color: #333;
    border-color: #d5d5d5;
  }

  /* ======= RWD (ajouts) : aucun changement visuel sur desktop ======= */

  /* Images produit fluides et non déformées */
  .product-img {
    max-width: 250px;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  /* Boutons group */
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Barre d’actions mobile (bouton Filtres) */
  .filters-toggle {
    display: none;
    justify-content: space-between;
    align-items: center;
    margin: 16px 0 8px;
  }

  .filters-toggle .btn-toggle {
    background: #fff;
    border: 1px solid #333;
    color: #333;
    border-radius: 22px;
    padding: 8px 14px;
    font-weight: 600;
  }

  .filters-toggle .btn-toggle:hover {
    background: rgb(243, 241, 238);
  }

  /* ≥ 992px : ton layout original 2 colonnes reste inchangé */

  /* ≤ 991px : on passe en une seule colonne + filtres repliables */
  @media (max-width: 991.98px) {
    .wrapper {
      margin: 24px 0 0;
    }

    .filters-toggle {
      display: flex;
    }

    /* Collapse par défaut sur mobile, visible d’emblée en desktop via classes dans le HTML */
    #filtersCollapse {
      border: 1px solid #eee;
      border-radius: 8px;
    }

    .list-group-item {
      padding: 16px;
    }

    .media {
      align-items: flex-start !important;
    }

    .media img {
      margin-bottom: 12px;
    }

    .product-img {
      max-width: 100%;
    }

    .product_price {
      font-size: 26px;
    }

    .btn-main {
      padding: 10px 18px;
    }
  }

  /* ≤ 767px : paddings compacts, boutons larges */
  @media (max-width: 767.98px) {
    .filters-text-top {
      padding: 10px;
    }

    .filters-text {
      padding: 10px;
    }

    .buttons .btn-main {
      width: 100%;
      max-width: 280px;
    }
  }

  /* ≤ 575px : cartes très lisibles */
  @media (max-width: 575.98px) {
    .product_price {
      font-size: 24px;
    }

    .panel-title>a {
      font-size: 10px;
      padding: 9px;
    }
  }

  /* Accessibilité : réduire mouvements */
  @media (prefers-reduced-motion: reduce) {

    .panel-title>a,
    .btn-main {
      transition: none;
    }
  }
</style>

<div class="background"></div>

{# Conserver les filtres au changement de catégorie #}
{% set all = app.request.query.all %}
{% set keep = all|filter((v,k) => k not in ['cat','page']) %}
{% set currentCat = app.request.get('cat') %}

<!-- Barre de recherche / prix -->
<div class="filters-text-top mb-3">
  <form method="get" action="{{ path('app_catalogue') }}" class="form-inline">
    <input type="text" name="q" value="{{ app.request.get('q') }}" class="form-control mr-2"
      placeholder="Rechercher un produit...">
    <input type="number" name="min" value="{{ app.request.get('min') }}" step="0.01" class="form-control mr-2"
      placeholder="Prix min (€)">
    <input type="number" name="max" value="{{ app.request.get('max') }}" step="0.01" class="form-control mr-2"
      placeholder="Prix max (€)">

    {% if currentCat is not null %}
    <input type="hidden" name="cat" value="{{ currentCat }}">
    {% endif %}

    <button type="submit" class="btn btn-dark">Filtrer</button>
    <a id="ReinitButton" href="{{ path('app_catalogue') }}" class="btn ml-2">Réinitialiser</a>
  </form>
</div>

<!-- Barre mobile : bouton pour ouvrir/fermer les filtres -->
<div class="filters-toggle d-md-none">
  <button class="btn-toggle" type="button" data-toggle="collapse" data-target="#filtersCollapse" aria-expanded="false"
    aria-controls="filtersCollapse">
    Filtres
  </button>
</div>

<div class="row">
  <!-- Filtres (Catégories) -->
  <div class="col-md-4">
    <!-- Visible par défaut en desktop, replié en mobile -->
    <div id="filtersCollapse" class="collapse d-md-block">
      <div class="wrapper center-block hidden-xs">
        <div class="filters-text">
          <span class="filter-span">Catégories</span>
        </div>

        <div class="panel-group">
          <!-- Toutes les catégories -->
          <div class="panel panel-default">
            <div class="panel-heading">
              <h4 class="panel-title">
                <a href="{{ path('app_catalogue', keep) }}"
                  class="btn btn-block btn-light text-left {{ currentCat is empty ? 'active' : '' }}">
                  Toutes les catégories
                </a>
              </h4>
            </div>
          </div>

          <!-- Catégories dynamiques -->
          {% for categorie in categories %}
          {% set isActive = (currentCat ~ '') == (categorie.id ~ '') %}
          <div class="panel panel-default">
            <div class="panel-heading">
              <h4 class="panel-title">
                <a href="{{ path('app_catalogue', keep|merge({'cat': categorie.id})) }}"
                  class="btn btn-block btn-light text-left {{ isActive ? 'active' : '' }}">
                  {{ categorie.name }}
                </a>
              </h4>
            </div>
          </div>
          {% else %}
          <p class="px-3">Aucune catégorie disponible.</p>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <!-- Produits -->
  <div class="col-md-8">
    <div class="container py-4 py-md-5">
      <div class="row">
        <div class="col-lg-12 mx-auto">
          <ul class="list-group shadow">
            {% for produit in produits %}
            <li class="list-group-item">
              <div class="media align-items-lg-center flex-column flex-lg-row">
                {% if produit.image %}
                <img src="{{ asset('images/' ~ produit.image) }}" alt="{{ produit.titre }}"
                  class="product-img img-fluid order-1 order-lg-1">
                {% endif %}

                <div class="media-body order-2 order-lg-2 ml-lg-5">
                  <h5 class="mt-0 mb-1">{{ produit.titre }}</h5>

                  <span class="product_price price-new">
                    {{ (produit.prix / 100)|number_format(2, '.', ' ') }} €
                  </span>

                  <hr class="mb-2 mt-1 seperator">

                  <div class="buttons">
                    <a href="{{ path('app_addCart', { id: produit.id }) }}" class="btn-main">Ajouter au panier</a>
                    <a href="{{ path('app_produit_show', { id: produit.id }) }}" class="btn-main">Voir le produit</a>
                  </div>
                </div>
              </div>
            </li>
            {% else %}
            <li class="list-group-item"><em>Aucun produit trouvé.</em></li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}