{% extends 'base.html.twig' %}

{% block title %}Bienvenue sur notre boutique{% endblock %}

{% block body %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<style>
    /* Style général */

    h2 {
        text-align: center;
        margin-bottom: 40px;
        margin-top: 30px;
    }

    .background {
        background-color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
    }

    /* Hero  */

    .hero {
        margin-top: 10px;
        display: flex;
        text-align: center;
        background-color: rgb(243, 241, 238);
        color: #333;
        margin-bottom: 50px;
        height: 500px;
    }

    .heroLeft {
        background-color: rgb(243, 241, 238);
        display: flex;
        flex-direction: column;
        width: 50%;
        padding: 90px 20px;
    }

    .buttons {
        margin-top: 10%;
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .heroRight {
        background-color: rgb(243, 241, 238);
        width: 50%;
        overflow: hidden;
        padding: auto;
    }

    .heroRight img {
        max-height: 500px;
        height: 100%;
        width: 100%;
        object-fit: cover;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-size: 100% 100%;
        filter: invert(30%) sepia(90%) saturate(500%) hue-rotate(190deg) brightness(95%) contrast(90%);
    }

    .hero h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
        opacity: 0;
        transform: translateY(60px);
        animation: fadeInUp 1s ease-out forwards;
    }

    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero p {
        font-size: 1.2rem;
        margin-bottom: 25px;
        opacity: 0;
        transform: translateY(60px);
        animation: fadeInUp 1s ease-out forwards;
        animation-delay: 0.5s;
    }

    /* Caroussel marques automatique  */

    .carousselContainer {
        display: flex;
        justify-content: center;
        align-items: center;
        background: #fff;
    }

    .logo-carousel,
    .logo-carousel2 {
        width: 70%;
        overflow: hidden;
        background: #fff;
    }

    .logo-track,
    .logo-track2 {
        display: flex;
        justify-content: center;
        gap: 60px;
        animation: scroll 25s linear infinite;
    }

    .logo-track2 {
        animation: scroll2 30s linear infinite;
    }

    .logo-track img,
    .logo-track2 img {
        height: 100px;
        object-fit: contain;
        filter: grayscale(100%);
        transition: filter 0.3s;
    }

    @keyframes scroll {
        from {
            transform: translateX(150%);
        }

        to {
            transform: translateX(-150%);
        }
    }

    @keyframes scroll2 {
        from {
            transform: translateX(-150%);
        }

        to {
            transform: translateX(150%);
        }
    }

    /* Cards  */
    .products {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        cursor: pointer;
    }

    .card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }

    .card-body {
        padding: 15px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .card-body h5 {
        font-size: 1.1rem;
        margin-bottom: 10px;
    }

    .card-body .price {
        font-weight: bold;
        margin-top: auto;
        margin-bottom: 10px;
    }

    .btn-add {
        background: #4caf50;
        color: white;
        text-align: center;
        padding: 10px;
        border-radius: 6px;
        text-decoration: none;
        display: inline-block;
        font-weight: 600;
    }

    .btn-add:hover {
        background: #43a047;
    }

    .d-flex {
        display: flex;
    }

    .align-center {
        align-items: center;
    }

    .flex-centerY-centerX {
        justify-content: center;
        align-items: center;
    }

    .sectionProduits {
        max-width: 2500px;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin-bottom: 50px;
    }

    .card {
        margin: 10px;
        display: flex;
        width: auto;
        overflow: hidden;
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 1.2s ease-out, transform 1.2s ease-out;
    }

    .card.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .el-wrapper {
        width: 360px;
        background-color: #fff;
    }

    @media (max-width: 991px) {
        .el-wrapper {
            width: 345px;
        }
    }

    @media (max-width: 767px) {
        .el-wrapper {
            width: 290px;
            margin: 30px auto;
        }
    }

    .el-wrapper:hover .h-bg {
        left: 0px;
    }

    .el-wrapper:hover .price {
        left: 20px;
        transform: translateY(-50%);
        color: #818181;
    }

    .el-wrapper:hover .add-to-cart {
        left: 50%;
    }

    .el-wrapper:hover .img {
        filter: blur(7px);
        opacity: 0.4;
    }

    .el-wrapper:hover .info-inner {
        bottom: 155px;
    }

    .el-wrapper:hover .a-size {
        transition-delay: 300ms;
        bottom: 50px;
        opacity: 1;
    }

    .el-wrapper .box-down {
        width: 100%;
        height: 60px;
        position: relative;
        overflow: hidden;
    }

    .el-wrapper .box-up {
        width: 100%;
        height: 300px;
        position: relative;
        overflow: hidden;
        text-align: center;
    }

    .el-wrapper .img {
        transition: all 800ms cubic-bezier(0, 0, 0.18, 1);
    }

    .h-bg {
        transition: all 800ms cubic-bezier(0, 0, 0.18, 1);
        width: 650px;
        height: 100%;
        background-color: rgb(243, 241, 238);
        position: absolute;
        left: -659px;
    }

    .h-bg .h-bg-inner {
        width: 50%;
        height: 100%;
        background-color: #333;
    }

    .info-inner {
        transition: all 400ms cubic-bezier(0, 0, 0.18, 1);
        position: absolute;
        width: 100%;
        bottom: 25px;
    }

    .info-inner .p-name,
    .info-inner .p-company {
        display: block;
    }

    .info-inner .p-name {
        margin-bottom: 10px;
        font-family: 'PT Sans', sans-serif;
        font-size: 18px;
        color: #252525;
    }

    .info-inner .p-company {
        font-family: 'Lato', sans-serif;
        font-size: 12px;
        text-transform: uppercase;
        color: #8c8c8c;
    }

    .a-size {
        transition: all 300ms cubic-bezier(0, 0, 0.18, 1);
        position: absolute;
        width: 100%;
        bottom: -20px;
        font-family: 'PT Sans', sans-serif;
        color: #828282;
        opacity: 0;
    }

    .a-size .size {
        color: #252525;
    }

    .cart {
        display: block;
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        font-family: 'Lato', sans-serif;
        font-weight: 700;
    }

    .cart .price {
        transition: all 600ms cubic-bezier(0, 0, 0.18, 1);
        transition-delay: 100ms;
        display: block;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 16px;
        color: #252525;
    }

    .cart .add-to-cart {
        transition: all 600ms cubic-bezier(0, 0, 0.18, 1);
        transition-delay: 100ms;
        display: block;
        position: absolute;
        top: 50%;
        left: 110%;
        transform: translate(-50%, -50%);
    }

    .cart .add-to-cart .txt {
        padding-left: 10px;
        font-size: 12px;
        color: #fff;
        letter-spacing: 0.045em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    /* Produits populaires (structure existante conservée) */
    .produitsPop {
        position: relative;
        min-height: 380px;
        overflow: hidden;
    }

    .backgroundProduitsPop {
        background: #333;
        width: 45%;
        height: 80%;
        position: absolute;
        top: 20%;
        right: 0;
        z-index: -1;
        border-radius: 0 25px 0 0;
        opacity: 0;
        transition: opacity 2.6s ease-out 1s, transform 2.6s ease-out 1s;
    }

    .backgroundProduitsPop.visible {
        opacity: 1;
        transform: scale(1);
    }

    .product-carousel {
        display: flex;
        justify-content: space-evenly;
        height: 100%;
        width: 100%;
        background-color: transparent;
    }

    .wrapper {
        display: flex;
        gap: 20px;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding-bottom: 10px;
        z-index: 1;
    }

    .product-card {
        position: relative;
        border-radius: 20px;
        width: 200px;
        height: 300px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        background: #fff;
        opacity: 0;
        transform: scale(0.98);
        transition: opacity 2.6s ease-out, transform 2.6s ease-out;
        z-index: 1;
    }

    .product-card.visible {
        opacity: 1;
        transform: scale(1);
    }

    .product-card:hover {
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }

    .product-card img:hover {
        filter: brightness(0.9);
    }

    .product-card img {
        width: 100%;
        height: 70%;
        object-fit: cover;
    }

    .product-info {
        padding: 15px;
        text-align: center;
    }

    .product-info h3 {
        font-size: 1rem;
        font-weight: bold;
        margin: 0;
        color: #333;
    }

    .card {
        color: #333;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 80%;
        border: 1px solid #eee;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        background: #fff;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }

    .card-body {
        height: 100px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        padding: 15px;
    }

    .card-body .titre {
        font-weight: bold;
        margin-bottom: 8px;
        font-size: 1.1rem;
        color: #333;
    }

    .card-body .price {
        font-weight: bold;
        margin-top: auto;
        margin-bottom: 10px;
        color: #333;
    }

    .btn-main {
        width: 200px;
        background: #333;
        color: #fff;
        padding: 12px 24px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: bold;
        transition: background 0.2s;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        border: 1px solid #333;
        opacity: 0;
        transform: translateY(60px);
        animation: fadeInUp 1s ease-out forwards;
        animation-delay: 1s;
    }

    .btn-main:hover {
        background: rgb(243, 241, 238);
        border: 1px solid #333;
        color: #333;
    }

    /* Footer */
    .col_white_amrc {
        color: #FFF;
    }

    footer {
        width: 100%;
        background: #333333;
        min-height: 250px;
        padding: 10px 0 25px 0;
    }

    .pt2 {
        padding-top: 40px;
        margin-bottom: 20px;
    }

    footer p {
        font-size: 13px;
        color: #CCC;
        margin-bottom: 8px;
    }

    .mb10 {
        padding-bottom: 15px;
    }

    .footer_ul_amrc {
        margin: 0;
        list-style: none;
        font-size: 14px;
        padding: 0 0 10px 0;
    }

    .footer_ul_amrc li {
        padding: 0 0 5px 0;
    }

    .footer_ul_amrc li a {
        color: #CCC;
    }

    .footer_ul_amrc li a:hover {
        color: #fff;
        text-decoration: none;
    }

    .fleft {
        float: left;
    }

    .padding-right {
        padding-right: 10px;
    }

    .footer_ul2_amrc {
        margin: 0;
        list-style: none;
        padding: 0;
    }

    .footer_ul2_amrc li p {
        display: table;
    }

    .footer_ul2_amrc li a:hover {
        text-decoration: none;
    }

    .footer_ul2_amrc li i {
        margin-top: 5px;
    }

    .bottom_border {
        border-bottom: 1px solid #323f45;
        padding-bottom: 20px;
    }

    .foote_bottom_ul_amrc {
        list-style: none;
        padding: 0;
        display: table;
        margin: 10px auto;
    }

    .foote_bottom_ul_amrc li {
        display: inline;
    }

    .foote_bottom_ul_amrc li a {
        color: #999;
        margin: 0 12px;
    }

    .social_footer_ul {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
        margin: 15px auto 0;
        list-style: none;
    }

    .social_footer_ul li {
        padding-top: 10px;
    }

    .social_footer_ul li a {
        color: #CCC;
        border: 1px solid #CCC;
        padding: 8px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
    }

    /* ========== RWD ONLY (ajouts) ========== */

    /* ≤ 1200px : réduire paddings et tailles */
    @media (max-width: 1200px) {
        .hero {
            height: 460px;
        }

        .heroLeft {
            padding: 70px 20px;
        }

        .hero h1 {
            font-size: 2.2rem;
        }

        .logo-track img,
        .logo-track2 img {
            height: 90px;
        }

        .logo-track,
        .logo-track2 {
            gap: 48px;
        }
    }

    /* ≤ 992px : passer le hero en colonnes, carousel plus bas, cartes plus compactes */
    @media (max-width: 992px) {
        .hero {
            flex-direction: column-reverse;
            height: auto;
        }

        .heroLeft,
        .heroRight {
            width: 100%;
        }

        .heroLeft {
            padding: 40px 16px 24px;
        }

        .heroRight img {
            max-height: 360px;
            height: 360px;
        }

        .buttons {
            margin-top: 24px;
            gap: 12px;
        }

        .btn-main {
            width: 180px;
            padding: 10px 18px;
        }

        .logo-carousel,
        .logo-carousel2 {
            width: 90%;
        }

        .logo-track img,
        .logo-track2 img {
            height: 80px;
        }

        .logo-track,
        .logo-track2 {
            gap: 40px;
        }

        .el-wrapper {
            width: 320px;
        }

        .el-wrapper .box-up {
            height: 260px;
        }

        .card img {
            height: 160px;
        }
    }

    /* ≤ 768px : textes plus grands lisibles, boutons sur 100%, grilles respirent */
    @media (max-width: 768px) {
        .hero h1 {
            font-size: 2rem;
        }

        .hero p {
            font-size: 1rem;
            margin-bottom: 18px;
        }

        .btn-main {
            width: 100%;
            max-width: 420px;
        }

        .logo-track img,
        .logo-track2 img {
            height: 70px;
        }

        .logo-track,
        .logo-track2 {
            gap: 28px;
        }

        .sectionProduits {
            padding: 0 8px;
        }

        .el-wrapper {
            width: 100%;
            max-width: 360px;
            margin: 18px auto;
        }

        .el-wrapper .box-up {
            height: 230px;
        }

        .product-card {
            width: 180px;
            height: 270px;
        }

        .product-info h3 {
            font-size: .95rem;
        }

        .foote_bottom_ul_amrc li a {
            margin: 0 8px;
        }
    }

    /* ≤ 576px : éléments tactiles, images plus basses, logos plus petits */
    @media (max-width: 576px) {
        .heroRight img {
            max-height: 280px;
            height: 280px;
        }

        .carousel-control-prev,
        .carousel-control-next {
            opacity: .9;
        }

        .carousel-control-prev,
        .carousel-control-next {
            width: 14%;
        }

        .logo-track img,
        .logo-track2 img {
            height: 56px;
        }

        .logo-track,
        .logo-track2 {
            gap: 20px;
        }

        .card {
            margin: 8px;
        }

        .card img {
            height: 150px;
        }

        .card-body {
            padding: 12px;
        }

        .card-body .titre {
            font-size: 1rem;
        }

        .card-body .price {
            font-size: .95rem;
        }

        .cart .price {
            font-size: 15px;
        }

        .cart .add-to-cart .txt {
            font-size: 11px;
        }

        footer {
            padding: 16px 0 22px;
        }
    }

    /* Préférence accessibilité : réduire mouvements si demandé */
    @media (prefers-reduced-motion: reduce) {

        .logo-track,
        .logo-track2 {
            animation: none;
        }

        .hero h1,
        .hero p,
        .btn-main,
        .card {
            animation: none;
            transition: none;
        }
    }
</style>

<div class="background"></div>

<!-- HERO -->
<div class="hero">
    <div class="heroLeft">
        <h1>Bienvenue sur notre boutique en ligne</h1>
        <p>Découvrez nos produits de qualité et faites-vous plaisir dès aujourd’hui.</p>
        <div class="buttons">
            <a href="{{ path('app_catalogue') }}" class="btn-main">Nos produits</a>
            <a href="{{ path('service_contact') }}" class="btn-main">Nous contacter ↗</a>
            <a href="{{ path('a_propos') }}" class="btn-main">Qui sommes nous</a>
        </div>
    </div>
    <div class="heroRight">
        <div id="carouselHomePage" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                {% for produit in produits %}
                <div class="carousel-item {% if loop.first %}active{% endif %}">
                    <img src="{{ asset('images/' ~ produit.image) }}" class="d-block w-100"
                        alt="Image de {{ produit.titre }}">
                </div>
                {% endfor %}
            </div>

            <!-- Controls -->
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselHomePage" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Précédent</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselHomePage" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Suivant</span>
            </button>
        </div>
    </div>
</div>

<!-- Logos défilants -->
