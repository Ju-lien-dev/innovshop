{# templates/front/detailProduit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ produit.titre }} - Catalogue{% endblock %}

{% block body %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300&display=swap');

    * {
        box-sizing: border-box;
    }

    .background {
        background-color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
    }

    .container-prod {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 20px 10px;
        font-family: 'Lato', sans-serif;
        color: #333;
    }

    .card-prod {
        background: #fff;
        width: 100%;
        max-width: 800px;
        margin: 20px auto;
        padding: 10px;
        box-shadow: 0 15px 30px rgba(0, 0, 0, .1);
    }

    .form-prod {
        display: flex;
        gap: 0;
    }

    .left-side,
    .right-side {
        width: 50%;
        padding: 20px;
    }

    /* Image principale */
    .main-image {
        width: 100%;
        height: 480px;
        border: 1px solid #eee;
        display: block;
        object-fit: cover;
        cursor: zoom-in;
    }

    /* Vignettes */
    .thumbs {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .thumbs span {
        width: 96px;
        height: 96px;
    }

    .thumbs img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border: 1px solid #eee;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

    .thumbs img:hover {
        transform: scale(1.03);
        box-shadow: 0 4px 12px rgba(0, 0, 0, .08);
    }

    /* Lightbox */
    .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .8);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .lightbox[aria-hidden="false"] {
        display: flex;
    }

    .lightbox-content {
        position: relative;
        max-width: 92vw;
        max-height: 92vh;
    }

    .lightbox-img {
        max-width: 92vw;
        max-height: 92vh;
        display: block;
        object-fit: contain;
        border-radius: 4px;
    }

    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {
        position: absolute;
        border: none;
        background: rgba(0, 0, 0, .5);
        color: #fff;
        width: 40px;
        height: 40px;
        border-radius: 999px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .lightbox-close {
        top: -50px;
        right: 0;
    }

    .lightbox-prev {
        left: -56px;
        top: 50%;
        transform: translateY(-50%);
    }

    .lightbox-next {
        right: -56px;
        top: 50%;
        transform: translateY(-50%);
    }

    /* Texte / boutons */
    .right-side h3 {
        margin-top: 10px;
    }

    .right-side h4 {
        margin-top: 8px;
    }

    .description {
        margin-top: 20px;
    }

    .actions {
        margin-top: 16px;
        display: flex;
        gap: 10px;
    }

    .btn-main {
        display: inline-block;
        background: #333;
        color: #fff;
        padding: 10px 16px;
        border-radius: 50px;
        border: 1px solid #333;
        font-size: 90%;
        text-decoration: none;
        font-weight: bold;
        transition: background .2s, color .2s;
    }

    .btn-main:hover {
        background: #f3f1ee;
        color: #333;
        text-decoration: none;
        box-shadow: 0 15px 30px rgba(0, 0, 0, .1);
    }

    @media (max-width: 750px) {
        .form-prod {
            flex-direction: column;
        }

        .left-side,
        .right-side {
            width: 100%;
            padding: 12px;
        }

        .main-image {
            height: 320px;
        }

        .lightbox-prev {
            left: 6px;
        }

        .lightbox-next {
            right: 6px;
        }

        .lightbox-close {
            top: 6px;
            right: 6px;
            background: rgba(0, 0, 0, .7);
        }
    }

    /* Empêche le scroll de fond quand la lightbox est ouverte */
    body.no-scroll {
        overflow: hidden;
    }
</style>

<div class="background"></div>

<section class="card-prod">
    <div class="container-prod">
        <div class="card-prod">
            <div class="form-prod">
                <div class="left-side">
                    {# image principale #}
                    <img id="main-img" class="main-image"
                        src="{{ asset('images/' ~ (produit.image ?? 'default.png')) }}" alt="{{ produit.titre }}"
                        data-index="0">

                    {# vignettes : on inclut l’image principale + les secondaires #}
                    {% set thumbs = [] %}
                    {% if produit.image %}
                    {% set thumbs = thumbs|merge([produit.image]) %}
                    {% endif %}
                    {% if produit.images is iterable and produit.images|length > 0 %}
                    {% set thumbs = thumbs|merge(produit.images) %}
                    {% endif %}

                    {% if thumbs|length > 0 %}
                    <div class="thumbs" id="thumbs">
                        {% for img in thumbs %}
                        <span>
                            <img class="thumb" src="{{ asset('images/' ~ img) }}"
                                alt="{{ produit.titre }} - {{ loop.index }}" data-index="{{ loop.index0 }}">
                        </span>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>

                <div class="right-side">
                    <h3>{{ produit.titre }}</h3>
                    <h4>{{ (produit.prix/100)|number_format(2, '.', ' ') }} €</h4>

                    <div class="description">
                        <h4>Description</h4>
                        <p>{{ produit.description|raw }}</p>
                    </div>

                    <div class="actions">
                        <a href="{{ path('app_catalogue') }}" class="btn-main">← Retour au catalogue</a>
                        <a href="{{ path('app_addCart', { id: produit.id }) }}" class="btn-main">Ajouter au panier</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# Lightbox markup #}
<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Agrandissement d'image"
    aria-hidden="true">
    <div class="lightbox-content">
        <button type="button" class="lightbox-close" id="lb-close" aria-label="Fermer">×</button>
        <button type="button" class="lightbox-prev" id="lb-prev" aria-label="Précédent">‹</button>
        <img id="lb-img" class="lightbox-img" src="" alt="{{ produit.titre }}">
        <button type="button" class="lightbox-next" id="lb-next" aria-label="Suivant">›</button>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const body = document.body;
        const mainImg = document.getElementById('main-img');
        const thumbs = Array.from(document.querySelectorAll('#thumbs .thumb'));
        const allSources = thumbs.length
            ? thumbs.map(t => t.src)
            : [mainImg.src];

        // Lightbox elements
        const lb = document.getElementById('lightbox');
        const lbImg = document.getElementById('lb-img');
        const btnPrev = document.getElementById('lb-prev');
        const btnNext = document.getElementById('lb-next');
        const btnClose = document.getElementById('lb-close');

        let currentIndex = 0;

        function openLightbox(idx) {
            currentIndex = idx;
            updateLightbox();
            lb.setAttribute('aria-hidden', 'false');
            body.classList.add('no-scroll');
        }

        function closeLightbox() {
            lb.setAttribute('aria-hidden', 'true');
            body.classList.remove('no-scroll');
        }

        function updateLightbox() {
            lbImg.src = allSources[currentIndex];
        }

        function prev() {
            currentIndex = (currentIndex - 1 + allSources.length) % allSources.length;
            updateLightbox();
        }

        function next() {
            currentIndex = (currentIndex + 1) % allSources.length;
            updateLightbox();
        }

        // Clics sur les vignettes → remplace l’image principale ET ouvre la lightbox
        thumbs.forEach(t => {
            t.addEventListener('click', () => {
                const idx = Number(t.dataset.index || 0);
                mainImg.src = t.src;
                mainImg.dataset.index = idx;
                openLightbox(idx);
            });
        });

        // Clic sur l'image principale → ouvre la lightbox à l'index courant
        mainImg.addEventListener('click', () => {
            const idx = Number(mainImg.dataset.index || 0);
            openLightbox(idx);
        });

        // Contrôles lightbox
        btnPrev.addEventListener('click', prev);
        btnNext.addEventListener('click', next);
        btnClose.addEventListener('click', closeLightbox);

        // Fermer en cliquant en dehors de l'image
        lb.addEventListener('click', (e) => {
            const content = e.target.closest('.lightbox-content');
            if (!content) closeLightbox();
        });

        // Clavier : Échap, flèches
        document.addEventListener('keydown', (e) => {
            if (lb.getAttribute('aria-hidden') === 'true') return;
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') prev();
            if (e.key === 'ArrowRight') next();
        });
    });
</script>
{% endblock %}