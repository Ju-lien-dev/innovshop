{# templates/security/register.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background:
            radial-gradient(1200px 600px at 10% 10%, rgba(99, 102, 241, .25), transparent 60%),
            radial-gradient(1200px 600px at 90% 90%, rgba(16, 185, 129, .25), transparent 60%),
            linear-gradient(135deg, #0f172a, #111827);
        color: #f9fafb;
        min-height: 100vh;
        padding: 32px;
    }

    .page {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: 1;
        padding: 2rem 0;
    }

    .auth-card {
        width: 100%;
        max-width: 460px;
        border-radius: 20px;
        background: rgba(255, 255, 255, .08);
        border: 1px solid rgba(255, 255, 255, .18);
        backdrop-filter: blur(14px) saturate(140%);
        box-shadow: 0 20px 60px rgba(0, 0, 0, .35);
        padding: 28px;
    }

    .auth-title {
        font-size: 1.6rem;
        font-weight: 700;
        text-align: center;
        margin: 0 0 18px;
    }

    .form-errors {
        background: rgba(220, 38, 38, 0.18);
        color: #fecaca;
        border-radius: 12px;
        padding: 10px 12px;
        margin-bottom: 14px;
        font-size: .95rem;
    }

    .auth-form label {
        display: block;
        color: #e5e7eb;
        font-weight: 600;
        font-size: .95rem;
        margin-bottom: 6px;
    }

    .auth-form input[type="email"],
    .auth-form input[type="password"],
    .auth-form input[type="text"] {
        width: 100%;
        box-sizing: border-box;
        margin: 0 0 14px;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, .18);
        background: rgba(255, 255, 255, .08);
        color: #f9fafb;
        font-size: 1rem;
        outline: none;
        transition: box-shadow .2s ease, border-color .2s ease, background .2s ease;
    }

    .auth-form input:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, .3);
        background: rgba(255, 255, 255, .1);
    }


    .checkbox-row {
        display: flex;
        align-items: center;
        gap: .6rem;
        margin-top: .25rem;
        margin-bottom: .5rem;
    }

    .checkbox-row input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #8b5cf6;
    }

    .checkbox-row label {
        margin: 0;
        font-weight: 500;
        color: #cbd5e1;
    }

    .btn-primary {
        width: 100%;
        padding: 12px 16px;
        border: none;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        background: linear-gradient(135deg, #8b5cf6, #22c55e);
        transition: transform .15s ease, filter .15s ease;
        margin-top: 8px;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        filter: brightness(1.05);
    }

    .muted {
        color: #94a3b8;
        font-size: .85rem;
        margin-top: 10px;
        text-align: center;
    }
</style>
{% endblock %}

{% block body %}
<div class="page">

    <div class="auth-card">
        <h1 class="auth-title">Créer un compte</h1>

        {# erreurs globales du formulaire #}
        {% if not registrationForm.vars.valid %}
        <div class="form-errors">
            {{ form_errors(registrationForm) }}
        </div>
        {% endif %}

        {{ form_start(registrationForm, {
        attr: { class: 'auth-form', novalidate: 'novalidate' }
        }) }}

        {# Email #}
        {{ form_row(registrationForm.email, {
        row_attr: { class: 'field' },
        attr: { placeholder: 'mon.email@example.com' },
        label: 'Email'
        }) }}

        {# Mot de passe #}
        {{ form_row(registrationForm.plainPassword, {
        row_attr: { class: 'field' },
        label: 'Mot de passe',
        attr: { placeholder: 'Votre mot de passe' }
        }) }}

        {# CGU / Terms #}
        <div class="checkbox-row">
            {{ form_widget(registrationForm.agreeTerms) }}
            {{ form_label(registrationForm.agreeTerms, 'J’accepte les conditions d’utilisation') }}
            {{ form_errors(registrationForm.agreeTerms) }}
        </div>

        <button type="submit" class="btn-primary">Créer mon compte</button>
        {{ form_end(registrationForm) }}

        <div class="muted">
            Vous avez déjà un compte ? <a href="{{ path('app_login') }}" style="color:#e5e7eb; text-decoration:none;">Se
                connecter</a>
        </div>
    </div>
</div>
{% endblock %}