{% extends 'base.html.twig' %}
{% block title %}Paiement réussi{% endblock %}

{% block body %}
<style>
    .background {
        background-color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
    }

    #success-page {
        --ink: #111827;
        --muted: #6b7280;
        --bg: #ffffff;
        --border: rgba(17, 24, 39, .10);
        --shadow: 0 16px 40px rgba(2, 6, 23, .08);
        color: var(--ink);
        background: var(--bg);
    }

    #success-page .wrap {
        max-width: 800px;
        margin: 60px auto;
        padding: 0 16px;
    }

    #success-page .card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: var(--shadow);
        padding: 40px 30px;
        text-align: center;
    }

    #success-page h1 {
        color: #16a34a;
        /* vert */
        font-weight: 800;
        margin-bottom: 20px;
    }

    #success-page p {
        color: var(--muted);
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    #success-page .btns {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }

    #success-page .btn {
        display: inline-block;
        padding: 12px 20px;
        border-radius: 25px;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        border: 1px solid #333;
    }

    #success-page .btn-primary {
        background: #111827;
        color: #fff;
    }

    #success-page .btn-primary:hover {
        background: #fff;
        color: #111827;
    }

    #success-page .btn-secondary {
        background: #fff;
        color: #111827;
    }

    #success-page .btn-secondary:hover {
        background: #f3f4f6;
    }
</style>
<div class="background"></div>

<div id="success-page">
    <div class="wrap">
        <div class="card">
            <h1>Paiement réussi</h1>
            <p>Merci pour votre commande.<br>
                Votre paiement a bien été confirmé et votre commande est en cours de traitement.</p>

            <div class="btns">
                <a href="{{ path('app_cart') }}" class="btn btn-primary">Voir mon panier</a>
                <a href="{{ path('app_catalogue') }}" class="btn btn-secondary">Continuer mes achats</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}