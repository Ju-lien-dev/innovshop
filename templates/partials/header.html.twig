{# templates/partials/header.html.twig #}
<style>
    :root {
        --logo-h: 80px;
        /* desktop */
        --header-h: 84px;
        /* desktop (un peu > logo) */
    }

    @media (max-width: 992px) {
        :root {
            --logo-h: 64px;
            --header-h: 68px;
        }
    }

    @media (max-width: 576px) {
        :root {
            --logo-h: 56px;
            --header-h: 60px;
        }
    }

    header.site-header {
        position: relative;
        z-index: 100;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .75rem 2rem;
        background: #fff;
        min-height: var(--header-h);
        /* ✅ réserve l’espace */
    }

    header .logo img {
        display: block;
        height: var(--logo-h);
        /* ✅ contraint le rendu */
        width: auto;
    }

    /* ====== Style existant ====== */
    nav ul li a {
        position: relative;
        display: inline-block;
        overflow: hidden;
        font-weight: 500;
        text-decoration: none;
        color: #333;
    }

    nav ul li a span {
        display: inline-block;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    nav ul li a::after {
        content: attr(data-text);
        position: absolute;
        left: 0;
        top: 100%;
        width: 100%;
        text-align: left;
        color: #888;
        opacity: 0;
        transition: all 0.3s ease;
    }

    nav ul li a:hover span {
        transform: translateY(-100%);
        opacity: 0;
    }

    nav ul li a:hover::after {
        top: 0;
        opacity: 1;
    }

    .cart-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

    .cart-badge {
        display: inline-flex;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        border-radius: 999px;
        background: #333;
        color: #fff;
        font-size: 12px;
        line-height: 22px;
        justify-content: center;
        align-items: center;
        transition: opacity .2s ease, visibility .2s ease;
    }

    /* ✅ Réserver l’espace même si panier vide */
    .cart-badge.is-empty {
        opacity: 0;
        visibility: hidden;
    }

    .hamburger {
        display: none;
        border: 1px solid #333;
        background: #fff;
        color: #333;
        border-radius: 8px;
        padding: .5rem .65rem;
        cursor: pointer;
        align-items: center;
        gap: .5rem;
        font: inherit;
    }

    .hamburger .bars {
        width: 20px;
        height: 14px;
        position: relative;
        display: inline-block;
    }

    .hamburger .bars::before,
    .hamburger .bars::after,
    .hamburger .bars span {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        height: 2px;
        background: #333;
        transition: transform .25s ease, opacity .25s ease;
    }

    .hamburger .bars::before {
        top: 0;
    }

    .hamburger .bars span {
        top: 6px;
    }

    .hamburger .bars::after {
        top: 12px;
    }

    nav.open+.hamburger .bars::before {
        transform: translateY(6px) rotate(45deg);
    }

    nav.open+.hamburger .bars span {
        opacity: 0;
    }

    nav.open+.hamburger .bars::after {
        transform: translateY(-6px) rotate(-45deg);
    }

    @media (max-width: 1200px) {
        header.site-header {
            padding: 0 1.25rem !important;
        }
    }

    @media (max-width: 992px) {
        .hamburger {
            display: inline-flex;
        }

        header.site-header {
            padding: .75rem 1rem !important;
        }

        header.site-header nav {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #fff;
            transform: translateY(-16px);
            opacity: 0;
            pointer-events: none;
            transition: transform .28s ease, opacity .28s ease;
            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);
            border-top: 1px solid #eee;
        }

        header.site-header nav.open {
            transform: translateY(0);
            opacity: 1;
            pointer-events: auto;
        }

        header.site-header nav ul {
            list-style: none !important;
            display: flex !important;
            flex-direction: column;
            margin: 0 !important;
            padding: .25rem 1rem 1rem !important;
        }

        header.site-header nav ul li a {
            display: block;
            padding: .85rem 0;
            font-size: 1.05rem;
            transition: color 0.25s ease, transform 0.25s ease, opacity 0.25s ease;
        }

        header.site-header nav ul li a:hover {
            transform: translateX(6px);
            color: #555;
            opacity: .85;
        }

        header.site-header nav ul li a:hover span {
            transform: none;
            opacity: 1;
        }

        header.site-header nav ul li a:hover::after {
            top: 100%;
            opacity: 0;
        }
    }

    @media (max-width: 576px) {
        .cart-badge {
            min-width: 20px;
            height: 20px;
            line-height: 20px;
            font-size: 11px;
        }
    }

    @media (prefers-reduced-motion: reduce) {

        nav ul li a,
        nav ul li a span,
        nav ul li a::after,
        header.site-header nav {
            transition: none !important;
        }
    }
</style>

<header class="site-header">
    <div class="logo">
        {# ✅ width/height HTML renseignés pour bloquer l’espace (ajuste si besoin à la vraie taille source) #}
        <a href="{{ path('app_front') }}" style="text-decoration:none; font-weight:bold; font-size:1.5rem; color:#333;">
            <img src="{{ asset('logo/logo_innovshop_transparent.png') }}" alt="InnovShop logo" width="800" height="240"
                {# <— mets ici la vraie taille du fichier si tu la connais #} decoding="async" loading="eager">
        </a>
    </div>

    <nav id="mainNav" aria-label="Navigation principale">
        <ul style="list-style:none; display:flex; gap:1.5rem; margin:0; padding:0;">
            <li><a href="{{ path('app_front') }}" data-text="Accueil"><span>Accueil</span></a></li>

            {% if app.user and 'ROLE_USER' in app.user.roles %}
            <li><a href="{{ path('app_account') }}" data-text="Mon compte"><span>Mon compte</span></a></li>
            {% endif %}

            <li><a href="{{ path('app_blog') }}" data-text="Dernières infos"><span>Dernières infos</span></a></li>
            <li><a href="{{ path('app_catalogue') }}" data-text="Catalogue"><span>Catalogue</span></a></li>

            <li>
                <a href="{{ path('app_cart') }}" data-text="Panier {% if cart_count > 0 %}{{ cart_count }}{% endif %}"
                    class="cart-link">
                    <span>Panier</span>
                    {# ✅ on rend TOUJOURS le badge pour réserver l’espace #}
                    {% set has_items = (cart_count is defined and cart_count > 0) %}
                    <span class="cart-badge {{ has_items ? '' : 'is-empty' }}">
                        {{ has_items ? cart_count : '0' }}
                    </span>
                </a>
            </li>

            {% if app.user and 'ROLE_USER' in app.user.roles %}
            <li><a href="{{ path('app_logout') }}" data-text="Déconnexion"><span>Déconnexion</span></a></li>
            {% else %}
            <li><a href="{{ path('app_login') }}" data-text="Connexion"><span>Connexion</span></a></li>
            {% endif %}

            {% if app.user and 'ROLE_ADMIN' in app.user.roles %}
            <li><a href="{{ path('admin') }}" data-text="Admin"><span>Admin</span></a></li>
            {% endif %}
        </ul>
    </nav>

    <button class="hamburger" id="navToggle" aria-controls="mainNav" aria-expanded="false" aria-label="Ouvrir le menu">
        <span class="bars"><span></span></span>
    </button>
</header>

<script>
    (function () {
        const nav = document.getElementById('mainNav');
        const btn = document.getElementById('navToggle');

        function closeOnEsc(e) {
            if (e.key === 'Escape' && nav.classList.contains('open')) {
                nav.classList.remove('open');
                btn.setAttribute('aria-expanded', 'false');
            }
        }

        btn.addEventListener('click', () => {
            const isOpen = nav.classList.toggle('open');
            btn.setAttribute('aria-expanded', String(isOpen));
        });

        document.addEventListener('keydown', closeOnEsc);

        nav.querySelectorAll('a').forEach(a => {
            a.addEventListener('click', () => {
                if (nav.classList.contains('open')) {
                    nav.classList.remove('open');
                    btn.setAttribute('aria-expanded', 'false');
                }
            });
        });
    })();
</script>